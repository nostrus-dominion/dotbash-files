#!/usr/bin/env bash
# description: Diagnose installation/dependencies and validate scripts; --test runs behavior checks.
# usage: dotbash-doctor [--check | --test | --help]

set -uo pipefail

usage() {
    cat <<'HELP'
Usage: dotbash-doctor [--check | --test | --help]
  no flag  Validate scripts and diagnose this machine's installation/dependencies.
  --check  Repository syntax, executable modes, metadata and optional ShellCheck.
  --test   Repository checks plus isolated archive/config/installer behavior tests.
Missing optional tools are warnings. Failed checks exit 1; invalid arguments exit 2.
The doctor never installs tools, modifies settings, or sources private local code.
HELP
}
mode=all
if (( $# > 1 )); then usage >&2; exit 2; fi
case ${1:-} in
    '') ;;
    --check) mode=check ;;
    --test) mode=test ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

# Follow the installed symlink before locating the checkout, including relative links.
script=${BASH_SOURCE[0]}
while [[ -L $script ]]; do
    link_dir=$(cd -P -- "$(dirname -- "$script")" && pwd) || exit 1
    script=$(readlink -- "$script") || exit 1
    [[ $script == /* ]] || script="$link_dir/$script"
done
repo_dir=$(cd -P -- "$(dirname -- "$script")/.." && pwd) || exit 1
failures=0 warnings=0
ok() { printf 'OK   %s\n' "$*"; }
warn() { printf 'WARN %s\n' "$*"; warnings=$((warnings + 1)); }
fail() { printf 'FAIL %s\n' "$*" >&2; failures=$((failures + 1)); }

check_repository() {
    local file first_line
    local -a bash_files=() ruby_files=()
    for file in .bashrc .bash_common .bash_exports .bash_aliases .bash_functions install.sh; do
        file="$repo_dir/$file"
        if bash -n "$file"; then bash_files+=("$file"); else fail "Bash syntax: $file"; fi
    done
    for file in "$repo_dir"/bin/*; do
        [[ -f $file ]] || { fail "Invalid command/link: $file"; continue; }
        [[ -x $file ]] || fail "Not executable: $file"
        grep -q '^# description:' "$file" || fail "Missing description: $file"
        grep -q '^# usage:' "$file" || fail "Missing usage: $file"
        IFS= read -r first_line < "$file" || :
        case $first_line in
            '#!/usr/bin/env bash'|'#!/bin/bash')
                bash -n "$file" || fail "Bash syntax: $file"
                bash_files+=("$file") ;;
            '#!/usr/bin/env ruby'|'#!/usr/bin/ruby') ruby_files+=("$file") ;;
            *) fail "Unsupported command interpreter: $file" ;;
        esac
    done
    if command -v git >/dev/null 2>&1 && git -C "$repo_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        while IFS= read -r file; do
            [[ -z $file ]] || fail "Git executable mode is not 100755: $file"
        done < <(git -C "$repo_dir" ls-files --stage -- bin/ | awk '$1 != "100755" {print $4}')
    fi
    for file in "$repo_dir"/tests/*.sh; do
        [[ -f $file ]] || continue
        bash -n "$file" || fail "Bash test syntax: $file"
        bash_files+=("$file")
    done
    (( failures != 0 )) || ok 'Bash syntax, command metadata and executable permissions'
    if (( ${#ruby_files[@]} )); then
        if command -v ruby >/dev/null 2>&1; then
            for file in "${ruby_files[@]}"; do ruby -c "$file" >/dev/null || fail "Ruby syntax: $file"; done
        else warn 'ruby missing: git wtf and Ruby syntax checks unavailable'; fi
    fi
    if command -v shellcheck >/dev/null 2>&1; then
        shellcheck -x -e SC1090,SC1091,SC2139 "${bash_files[@]}" && ok ShellCheck || fail ShellCheck
    else warn 'ShellCheck missing: lint skipped'; fi
}

check_machine() {
    local file name resolved tool consumers version spec
    case ":$PATH:" in *":$HOME/.local/bin:"*) ok '~/.local/bin is on PATH' ;; *) warn '~/.local/bin is absent from PATH; open/reload Bash after installing' ;; esac
    for file in "$repo_dir"/bin/*; do
        name=${file##*/}
        if [[ -L $HOME/.local/bin/$name && ! -e $HOME/.local/bin/$name ]]; then
            fail "Broken command symlink: $name"
        elif [[ -e $HOME/.local/bin/$name ]]; then
            [[ $HOME/.local/bin/$name -ef $file ]] || warn "Installed $name does not point to this checkout; rerun install.sh"
        else warn "$name is not installed; run bash install.sh"; fi
        resolved=$(type -P "$name" || :)
        if [[ -n $resolved && ! $resolved -ef $file ]]; then warn "$name is shadowed on PATH by $resolved"; fi
    done
    # Private code is inspected for syntax only, never executed by the doctor.
    if [[ -f $HOME/.bash_local ]]; then
        bash -n "$HOME/.bash_local" && ok '~/.bash_local syntax' || fail '~/.bash_local syntax'
        [[ ! -L $HOME/.bash_local ]] || warn '~/.bash_local is symlinked; installer will make it independent'
        if [[ $(ls -ld "$HOME/.bash_local" | awk '{print substr($1,5,6)}') != ------ ]]; then warn '~/.bash_local is readable/writable by others; use chmod 600'; fi
        grep -Eq '(^|[[:space:];])(export[[:space:]]+)?(PS1|PROMPT_COMMAND)=' "$HOME/.bash_local" || warn 'No local prompt assignment found'
        grep -q '^# dotbash-history-policy:' "$HOME/.bash_local" || warn 'No installer history policy found; shared default is 1000'
        if grep -Eq '^[[:space:]]*alias[[:space:]]+(server|ports|dotbash-doctor)=' "$HOME/.bash_local"; then
            warn 'Local aliases may shadow managed commands; use type -a COMMAND in your current shell'
        fi
    else warn '~/.bash_local missing; run bash install.sh'; fi
    for file in "$HOME/.bash_prompt" "$HOME/.local/gitconfig" "${XDG_CONFIG_HOME:-$HOME/.config}/dotbash-files/history"; do
        [[ ! -e $file && ! -L $file ]] || warn "Legacy settings remain: $file; rerun install.sh to migrate"
    done
    for file in .bashrc .bash_common .bash_exports .bash_aliases .bash_functions; do
        if [[ -L $HOME/$file && ! -e $HOME/$file ]]; then fail "Broken shell symlink: $file"
        elif [[ -e $HOME/$file && $HOME/$file -ef $repo_dir/$file ]]; then ok "Installed $file"
        else warn "$file does not point to this checkout"; fi
    done
    # Per-command dependencies are optional for the installation as a whole.
    while IFS='|' read -r tool consumers; do
        if command -v "$tool" >/dev/null 2>&1; then ok "$tool ($consumers)"; else warn "$tool missing: $consumers"; fi
    done <<'DEPS'
python3|server, zipit, ytdl
ruby|git wtf
curl|web helpers
jq|JSON helpers
dig|digga
openssl|getcerts
tar|store, targz, extract
gzip|targz fallback
pigz|optional multicore targz compression
tree|tre
less|tre and man pager
ss|ports
ip|network helpers
systemctl|comfy (systemd hosts only)
yt-dlp|ytdl
ffmpeg|ytdl media processing
rsync|copy/backup helpers
bc|calc
lynx|text browsing
pygmentize|syntax-highlighted helpers
unzip|extract .zip
bzip2|extract .bz2
xz|extract .tar.xz
7z|extract .7z
DEPS
    if command -v tar >/dev/null 2>&1; then
        [[ $(tar --version 2>/dev/null) == *'GNU tar'* ]] || command -v gtar >/dev/null 2>&1 || warn 'store requires GNU tar; install gtar on macOS'
    fi
    printf '\nRuntime versions:\n'
    printf '  bash %s\n' "$BASH_VERSION"
    for spec in python3 node php ruby git; do
        command -v "$spec" >/dev/null 2>&1 || continue
        version=$("$spec" --version 2>&1 | head -n 1)
        printf '  %s\n' "$version"
    done
    if command -v git >/dev/null 2>&1; then
        git config --global --get user.name >/dev/null 2>&1 && git config --global --get user.email >/dev/null 2>&1 && ok 'Native Git identity configured' || warn 'Native Git identity incomplete'
    fi
}

check_repository
if [[ $mode == all ]]; then check_machine; fi
if [[ $mode == test ]]; then
    if bash "$repo_dir/tests/behavior.sh" "$repo_dir"; then ok 'Isolated behavior tests'; else fail 'Behavior tests'; fi
fi
printf '\nDoctor: %d failure(s), %d warning(s).\n' "$failures" "$warnings"
(( failures == 0 ))
