# Shared interactive Bash configuration.
[[ $- == *i* ]] || return 0

if [[ -r $HOME/.bash_exports ]]; then
    source "$HOME/.bash_exports" || return $?
fi

HISTCONTROL=ignoreboth
shopt -s histappend checkwinsize
HISTSIZE=1000
HISTFILESIZE=2000

if [[ -x /usr/bin/lesspipe ]]; then
    eval "$(SHELL=/bin/sh lesspipe)"
fi
if [[ -z ${debian_chroot:-} && -r /etc/debian_chroot ]]; then
    debian_chroot=$(</etc/debian_chroot)
fi

if command -v dircolors >/dev/null 2>&1; then
    if [[ -r $HOME/.dircolors ]]; then
        eval "$(dircolors -b "$HOME/.dircolors")"
    else
        eval "$(dircolors -b)"
    fi
    alias ls='ls --color=auto --group-directories-first'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

if [[ -r $HOME/.bash_aliases ]]; then
    source "$HOME/.bash_aliases" || return $?
fi
# Remove legacy function versions that were moved into bin/.
unset -f comfy comfy-backup ytdl ports port freeport 2>/dev/null || :
unalias ports port freeport server 2>/dev/null || :
hash -r

if [[ -r $HOME/.bash_functions ]]; then
    source "$HOME/.bash_functions" || return $?
fi

# Node Version Manager. If NVM is not installed on this machine, these do nothing.
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    source "$NVM_DIR/nvm.sh"
fi

if [[ -s "$NVM_DIR/bash_completion" ]]; then
    source "$NVM_DIR/bash_completion"
fi

if ! shopt -oq posix; then
    if [[ -r /usr/share/bash-completion/bash_completion ]]; then
        source /usr/share/bash-completion/bash_completion
    elif [[ -r /etc/bash_completion ]]; then
        source /etc/bash_completion
    fi
fi

# Optional machine-specific/private overrides. This file is user-owned and
# is never created or managed by dotbash-files.
if [[ -r $HOME/.bash_local ]]; then
    source "$HOME/.bash_local" || return $?
fi
