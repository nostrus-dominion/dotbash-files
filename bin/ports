#!/usr/bin/env bash
# description: List, inspect, or free listening TCP/UDP ports.
# usage: ports [--free] [port]

set -u

usage() {
    cat <<'EOF'
Usage:
  ports
  ports <port>
  ports -f <port>
  ports --free <port>

Commands:
  ports               List listening TCP/UDP sockets.
  ports <port>        Inspect one listening TCP/UDP port.
  ports -f <port>     Gracefully terminate visible processes using the port.
  ports --free <port> Same as -f.
  ports -h, --help    Show this help.

Process details for services owned by another user may require root privileges.
EOF
}

validate_port() {
    local value=$1

    if [[ ! $value =~ ^[0-9]+$ || ${#value} -gt 5 ]]; then
        return 1
    fi

    local number=$((10#$value))
    (( number >= 1 && number <= 65535 ))
}

socket_rows() {
    local port=$1
    ss -H -tulnp "sport = :$port" 2>/dev/null
}

show_port() {
    local port=$1
    local rows

    rows=$(socket_rows "$port")

    if [[ -z $rows ]]; then
        printf 'Nothing is listening on TCP/UDP port %s.\n' "$port"
        return 1
    fi

    ss -tulnp "sport = :$port"

    if (( EUID != 0 )) && printf '%s\n' "$rows" | grep -vq 'users:('; then
        local self
        self=$(readlink -f -- "${BASH_SOURCE[0]}")
        echo
        echo 'Some process details are hidden from this user.'
        printf 'Try: sudo %q %s\n' "$self" "$port"
    fi
}

free_port() {
    local port=$1
    local rows
    local pids
    local pid

    rows=$(socket_rows "$port")

    if [[ -z $rows ]]; then
        printf 'Port %s is already free.\n' "$port"
        return 0
    fi

    echo "Processes using port $port:"
    ss -tulnp "sport = :$port"
    echo

    pids=$(
        printf '%s\n' "$rows" |
            grep -oE 'pid=[0-9]+' |
            cut -d= -f2 |
            sort -u
    )

    if [[ -z $pids ]]; then
        local self
        self=$(readlink -f -- "${BASH_SOURCE[0]}")
        printf 'Port %s is in use, but the owning process is hidden from this user.\n' "$port" >&2
        printf 'Try: sudo %q --free %s\n' "$self" "$port" >&2
        return 1
    fi

    while IFS= read -r pid; do
        [[ -n $pid ]] || continue
        printf 'Sending TERM to PID %s...\n' "$pid"

        if ! kill "$pid" 2>/dev/null; then
            printf 'Warning: could not terminate PID %s.\n' "$pid" >&2
        fi
    done <<< "$pids"

    sleep 1

    rows=$(socket_rows "$port")

    if [[ -z $rows ]]; then
        printf 'Port %s is now free.\n' "$port"
        return 0
    fi

    echo
    printf 'Port %s is still in use:\n' "$port"
    ss -tulnp "sport = :$port"

    if (( EUID != 0 )) && printf '%s\n' "$rows" | grep -vq 'users:('; then
        local self
        self=$(readlink -f -- "${BASH_SOURCE[0]}")
        echo
        echo 'Remaining process details are hidden from this user.'
        printf 'Try: sudo %q --free %s\n' "$self" "$port"
    fi

    return 1
}

command -v ss >/dev/null 2>&1 || {
    echo 'Error: ss is not installed or not in PATH.' >&2
    exit 1
}

case "${1:-}" in
    -h|--help)
        (( $# == 1 )) || {
            usage >&2
            exit 2
        }
        usage
        ;;

    -f|--free)
        (( $# == 2 )) || {
            usage >&2
            exit 2
        }

        validate_port "$2" || {
            echo 'Port must be between 1 and 65535.' >&2
            exit 2
        }

        free_port "$((10#$2))"
        ;;

    "")
        (( $# == 0 )) || {
            usage >&2
            exit 2
        }
        ss -tulnp
        ;;

    *)
        (( $# == 1 )) || {
            usage >&2
            exit 2
        }

        validate_port "$1" || {
            echo 'Port must be between 1 and 65535.' >&2
            exit 2
        }

        show_port "$((10#$1))"
        ;;
esac
