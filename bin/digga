#!/usr/bin/env bash
# description: Query DNS with concise, readable dig output.
# usage: digga name [type] [server]

set -u

usage() {
    cat <<'EOF'
Usage:
  digga name [type] [server]
  digga IP-address [server]

Defaults:
  type    A
  server  system resolver

Modern conveniences:
  - IPv4/IPv6 input automatically performs a reverse PTR lookup.
  - A resolver may be written as 10.1.10.1 or @10.1.10.1.
  - Queries use short timeouts and show status, answers, and authority data.

Examples:
  digga domain.com
  digga domain.com MX
  digga sub.domain.com A 10.1.10.1
  digga sub.domain.com A @1.1.1.1
  digga 192.168.1.10
EOF
}

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    (( $# == 1 )) || {
        usage >&2
        exit 2
    }
    usage
    exit 0
fi

if (( $# < 1 || $# > 3 )); then
    usage >&2
    exit 2
fi

command -v dig >/dev/null 2>&1 || {
    echo 'Error: dig is required (Debian/Ubuntu package: dnsutils).' >&2
    exit 1
}

name=$1
second=${2:-}
third=${3:-}
server=''
record_type='A'

# If the first argument looks like an IP address and no explicit record type
# was supplied, perform the reverse lookup automatically.
if [[ $name =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ || $name == *:* ]]; then
    if [[ -n $third ]]; then
        usage >&2
        exit 2
    fi

    server=$second
    args=(-x "$name")
else
    if [[ $second == @* ]]; then
        server=$second
    elif [[ -n $second ]]; then
        record_type=${second^^}
        server=$third
    fi

    args=("$name" "$record_type")
fi

if [[ -n $server ]]; then
    server=${server#@}
    args=("@$server" "${args[@]}")
fi

exec dig \
    +time=3 \
    +tries=1 \
    +nocmd \
    +noall \
    +comments \
    +answer \
    +authority \
    "${args[@]}"
