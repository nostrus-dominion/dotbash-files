#!/usr/bin/env bash
# description: Show a self-updating reference of custom shell commands.
# usage: my-commands

set -u

if (( $# != 0 )); then
    echo "Usage: my-commands" >&2
    exit 2
fi

echo "MY COMMANDS"
echo "==========="
echo

echo "ALIASES"
echo "======="
if [[ -r $HOME/.bash_aliases ]]; then
    sed -n -E "s/^alias ([^=]+)=(.*)$/  \\1                  \\2/p" "$HOME/.bash_aliases"
fi

echo
echo "FUNCTIONS"
echo "========="
for file in "$HOME/.bash_functions" "$HOME"/.bash_functions.d/*.bash; do
    [[ -r $file ]] || continue
    awk '
        /^[[:space:]]*#[^!]/ {
            comment=$0
            sub(/^[[:space:]]*#[[:space:]]?/, "", comment)
            if (comment ~ /^=+$/ || comment == "") desc=""
            else desc=comment
            next
        }
        /^[[:space:]]*[a-zA-Z_][a-zA-Z0-9_-]*\(\)[[:space:]]*\{/ {
            line=$0
            sub(/^[[:space:]]*/, "", line)
            name=line
            sub(/\(\).*/, "", name)
            printf "  %-22s %s\n", name, desc
            desc=""
            next
        }
        /^[[:space:]]*$/ { next }
        { desc="" }
    ' "$file"
done

echo
echo "STANDALONE COMMANDS"
echo "==================="
if [[ -d $HOME/.local/bin ]]; then
    for file in "$HOME"/.local/bin/*; do
        [[ -f $file && -x $file ]] || continue
        name=$(basename -- "$file")
        usage=$(awk -F': *' '/^# usage:/ {sub(/^# usage:[[:space:]]*/, ""); print; exit}' "$file")
        description=$(awk -F': *' '/^# description:/ {sub(/^# description:[[:space:]]*/, ""); print; exit}' "$file")
        [[ -n $usage ]] || usage=$name
        printf '  %-22s %s\n' "$usage" "$description"
    done
fi
