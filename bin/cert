#!/usr/bin/env bash
# description: Inspect the TLS certificate presented by a host.
# usage: cert host [port]

set -u

usage() {
    cat <<'EOF'
Usage: cert host [port]

Examples:
  cert nostrus-dominion.co
  cert nostrus-dominion.co 8443
  cert https://nostrus-dominion.co/path
EOF
}

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    (( $# == 1 )) || {
        usage >&2
        exit 2
    }
    usage
    exit 0
fi

if (( $# < 1 || $# > 2 )); then
    usage >&2
    exit 2
fi

command -v openssl >/dev/null 2>&1 || {
    echo 'Error: openssl is required.' >&2
    exit 1
}

target=$1
port=${2:-443}

target=${target#*://}
target=${target%%/*}

if (( $# == 1 )) && [[ $target == *:* ]]; then
    port=${target##*:}
    target=${target%%:*}
fi

if [[ -z $target ]]; then
    echo 'Error: host is empty.' >&2
    exit 2
fi

if [[ ! $port =~ ^[0-9]+$ || ${#port} -gt 5 ]] || (( 10#$port < 1 || 10#$port > 65535 )); then
    echo 'Port must be between 1 and 65535.' >&2
    exit 2
fi

port=$((10#$port))
tmp=$(mktemp)
trap 'rm -f -- "$tmp"' EXIT

if ! openssl s_client -connect "$target:$port" -servername "$target" </dev/null 2>/dev/null |
    sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' |
    head -n 1000 > "$tmp"; then
    printf 'Error: unable to retrieve certificate from %s:%s.\n' "$target" "$port" >&2
    exit 1
fi

if ! openssl x509 -in "$tmp" -noout >/dev/null 2>&1; then
    printf 'Error: no valid certificate received from %s:%s.\n' "$target" "$port" >&2
    exit 1
fi

printf 'Certificate: %s:%s\n\n' "$target" "$port"
openssl x509 -in "$tmp" -noout -subject -issuer -startdate -enddate

echo
echo 'Subject Alternative Names:'
openssl x509 -in "$tmp" -noout -ext subjectAltName 2>/dev/null |
    sed '1d; s/^[[:space:]]*//'

end_date=$(openssl x509 -in "$tmp" -noout -enddate | cut -d= -f2-)
if end_epoch=$(date -d "$end_date" +%s 2>/dev/null); then
    now_epoch=$(date +%s)
    seconds_left=$((end_epoch - now_epoch))

    if (( seconds_left >= 0 )); then
        days_left=$(((seconds_left + 86399) / 86400))
        printf '\nExpires in: %d day(s)\n' "$days_left"
    else
        days_expired=$(((-seconds_left + 86399) / 86400))
        printf '\nEXPIRED: %d day(s) ago\n' "$days_expired"
    fi
fi
