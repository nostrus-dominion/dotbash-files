#!/usr/bin/env bash
# description: Serve the current directory in the background with Basic Auth by default.
# usage: server [--unsecure] [port] | server --stop

set -u

idle_timeout=1800

format_duration() {
    local seconds=$1

    if (( seconds >= 3600 && seconds % 3600 == 0 )); then
        local hours=$((seconds / 3600))
        printf '%d hour%s' "$hours" "$([[ $hours -eq 1 ]] && printf '' || printf 's')"
    elif (( seconds >= 60 && seconds % 60 == 0 )); then
        local minutes=$((seconds / 60))
        printf '%d minute%s' "$minutes" "$([[ $minutes -eq 1 ]] && printf '' || printf 's')"
    else
        printf '%d second%s' "$seconds" "$([[ $seconds -eq 1 ]] && printf '' || printf 's')"
    fi
}

runtime_base=${XDG_RUNTIME_DIR:-"${TMPDIR:-/tmp}/dotbash-$UID"}
runtime_dir="$runtime_base/dotbash-files"
state_base=${XDG_STATE_HOME:-"$HOME/.local/state"}
state_dir="$state_base/dotbash-files"

pid_file="$runtime_dir/server.pid"
log_file="$state_dir/server.log"

usage() {
    cat <<'EOF'
Usage:
  server [port]
  server -u [port]
  server --unsecure [port]
  server --stop
  server -h, --help

The default port is 8000.

By default, server generates temporary credentials and requires HTTP Basic
Authentication. Use --unsecure to serve without authentication.

The server detaches from the terminal and automatically stops after the
configured idle timeout without an HTTP request. Use 'server --stop' to stop
it manually.

Basic Auth protects against casual access, but plain HTTP is not encrypted.
EOF

    printf 'Current idle timeout: %s\n' "$(format_duration "$idle_timeout")"
}

open_browser() {
    local url=$1

    if command -v xdg-open >/dev/null 2>&1 && [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
        (
            sleep 1
            xdg-open "$url" >/dev/null 2>&1
        ) &
        disown 2>/dev/null || :
    fi
}

managed_pid() {
    [[ -r $pid_file ]] || return 1

    local pid
    read -r pid < "$pid_file" || return 1
    [[ $pid =~ ^[0-9]+$ ]] || return 1

    if kill -0 "$pid" 2>/dev/null; then
        printf '%s\n' "$pid"
        return 0
    fi

    rm -f -- "$pid_file"
    return 1
}

stop_server() {
    mkdir -p -- "$runtime_dir"

    local pid
    if ! pid=$(managed_pid); then
        echo 'No dotbash server is running.'
        return 0
    fi

    printf 'Stopping server PID %s...\n' "$pid"
    kill -TERM "$pid" 2>/dev/null || {
        printf 'Error: could not stop PID %s.\n' "$pid" >&2
        return 1
    }

    local attempt
    for attempt in {1..30}; do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f -- "$pid_file"
            echo 'Server stopped.'
            return 0
        fi
        sleep 0.1
    done

    printf 'PID %s did not stop after TERM; sending KILL...\n' "$pid"
    kill -KILL "$pid" 2>/dev/null || {
        printf 'Error: could not kill PID %s.\n' "$pid" >&2
        return 1
    }

    rm -f -- "$pid_file"
    echo 'Server stopped.'
}

secure=true
port=8000

case "${1:-}" in
    -h|--help)
        (( $# == 1 )) || {
            usage >&2
            exit 2
        }
        usage
        exit 0
        ;;
    --stop)
        (( $# == 1 )) || {
            usage >&2
            exit 2
        }
        stop_server
        exit $?
        ;;
    -u|--unsecure)
        secure=false
        shift
        ;;
esac

if (( $# > 1 )); then
    usage >&2
    exit 2
fi

if (( $# == 1 )); then
    port=$1
fi

if [[ ! $port =~ ^[0-9]+$ || ${#port} -gt 5 ]] || (( 10#$port < 1 || 10#$port > 65535 )); then
    echo 'Port must be between 1 and 65535.' >&2
    exit 2
fi

port=$((10#$port))

command -v python3 >/dev/null 2>&1 || {
    echo 'Error: python3 is required.' >&2
    exit 1
}

mkdir -p -- "$runtime_dir" "$state_dir"
chmod 0700 -- "$runtime_dir" "$state_dir" 2>/dev/null || :

if existing_pid=$(managed_pid); then
    printf 'A dotbash server is already running as PID %s.\n' "$existing_pid" >&2
    echo "Stop it first with: server --stop" >&2
    exit 1
fi

url="http://localhost:$port"
username=''
password=''

if [[ $secure == true ]]; then
    username='user'

    if command -v openssl >/dev/null 2>&1; then
        password=$(openssl rand -base64 18 | tr -d '\n')
    else
        password=$(python3 -c 'import secrets; print(secrets.token_urlsafe(18))')
    fi
fi

: > "$log_file"
chmod 0600 -- "$log_file" 2>/dev/null || :

SERVER_SECURE=$secure \
SERVER_USER=$username \
SERVER_PASSWORD=$password \
SERVER_PORT=$port \
SERVER_IDLE_TIMEOUT=$idle_timeout \
SERVER_PID_FILE=$pid_file \
python3 - >>"$log_file" 2>&1 <<'PY' &
import base64
import os
import signal
import threading
import time
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

secure = os.environ["SERVER_SECURE"].lower() == "true"
user = os.environ["SERVER_USER"]
password = os.environ["SERVER_PASSWORD"]
port = int(os.environ["SERVER_PORT"])
idle_timeout = int(os.environ["SERVER_IDLE_TIMEOUT"])
pid_file = os.environ["SERVER_PID_FILE"]
expected = (
    "Basic " + base64.b64encode(f"{user}:{password}".encode()).decode()
    if secure
    else ""
)


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


class Handler(SimpleHTTPRequestHandler):
    def handle_one_request(self):
        self.server.last_activity = time.monotonic()
        super().handle_one_request()

    def _authorized(self):
        if not secure or self.headers.get("Authorization") == expected:
            return True

        self.send_response(401)
        self.send_header("WWW-Authenticate", 'Basic realm="dotbash server"')
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.end_headers()
        self.wfile.write(b"Authentication required.\n")
        return False

    def do_GET(self):
        if self._authorized():
            super().do_GET()

    def do_HEAD(self):
        if self._authorized():
            super().do_HEAD()


httpd = Server(("0.0.0.0", port), Handler)
httpd.last_activity = time.monotonic()


def idle_watchdog():
    while True:
        time.sleep(5)
        if time.monotonic() - httpd.last_activity >= idle_timeout:
            httpd.shutdown()
            return


def stop_handler(_signum, _frame):
    raise KeyboardInterrupt


signal.signal(signal.SIGTERM, stop_handler)
signal.signal(signal.SIGINT, stop_handler)
threading.Thread(target=idle_watchdog, daemon=True).start()

try:
    httpd.serve_forever()
except KeyboardInterrupt:
    pass
finally:
    httpd.server_close()

    try:
        with open(pid_file, "r", encoding="utf-8") as handle:
            recorded_pid = handle.read().strip()
        if recorded_pid == str(os.getpid()):
            os.unlink(pid_file)
    except (FileNotFoundError, OSError):
        pass
PY

server_pid=$!
printf '%s\n' "$server_pid" > "$pid_file"
disown "$server_pid" 2>/dev/null || :

sleep 0.2
if ! kill -0 "$server_pid" 2>/dev/null; then
    rm -f -- "$pid_file"
    echo 'Error: server failed to start.' >&2
    [[ ! -s $log_file ]] || tail -n 20 "$log_file" >&2
    exit 1
fi

if [[ $secure == true ]]; then
    printf 'Serving %s at %s\n' "$PWD" "$url"
    echo
    printf 'Username: %s\n' "$username"
    printf 'Password: %s\n' "$password"
    echo
    echo 'NOTE: Authentication is enabled, but plain HTTP does not encrypt traffic.'
else
    printf 'Serving %s at %s WITHOUT authentication.\n' "$PWD" "$url"
fi

printf 'PID: %s\n' "$server_pid"
printf 'Log: %s\n' "$log_file"
printf 'Idle timeout: %s\n' "$(format_duration "$idle_timeout")"
echo 'Stop with: server --stop'

open_browser "$url"
